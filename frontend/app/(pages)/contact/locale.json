      "consultation": {
        "title": "Advice",
        "text": "Vaccination can protect against serious diseases, and thanks to the childhood vaccination program, many diseases are now rare in Denmark."
      },
      "travel": {
        "title": "Travel guidance",
        "text": "When you travel outside Denmark, vaccinations may be relevant for diseases not covered by the Danish childhood vaccination program."
      },
